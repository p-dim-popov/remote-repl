{
  "name": "@remote-repl/express",
  "version": "1.0.2",
  "description": "Express router for remote-repl: mounts the live REPL (command endpoint, SSE stream, Monaco UI) onto any Express app.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p-dim-popov/remote-repl.git",
    "directory": "packages/express"
  },
  "bugs": {
    "url": "https://github.com/p-dim-popov/remote-repl/issues"
  },
  "homepage": "https://github.com/p-dim-popov/remote-repl#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "example": "ts-node -T example/main.ts"
  },
  "dependencies": {
    "@remote-repl/core": "^1.0.1"
  },
  "peerDependencies": {
    "express": "^4.16 || ^5"
  },
  "devDependencies": {
    "@types/express": "^5",
    "@types/node": "^20",
    "@types/supertest": "^6",
    "express": "^5",
    "express4": "npm:express@^4.22.3",
    "supertest": "^7",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^2"
  }
}
